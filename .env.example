# =============================================================================
# Baserow (source of truth for properties)
# =============================================================================
BASEROW_URL=https://place-research-baserow.snake-snares.ts.net
# Database token with create/read/update on the place-research database
BASEROW_API_TOKEN=
BASEROW_DATABASE_ID=259
BASEROW_PROPERTIES_TABLE_ID=837
# Printed by scripts/baserow_setup.py
BASEROW_LOCATIONS_TABLE_ID=
BASEROW_SETTINGS_TABLE_ID=
# Shared secret sent by the Baserow webhook (openssl rand -hex 32)
BASEROW_WEBHOOK_SECRET=
# How often to enrich rows whose webhook was missed (seconds)
BASEROW_SWEEP_INTERVAL_SECONDS=900

# =============================================================================
# iOS Shortcut ingest token (openssl rand -hex 32)
# =============================================================================
INGEST_API_TOKEN=

# =============================================================================
# External API Keys
# =============================================================================
GOOGLE_MAPS_API_KEY=
WALKSCORE_API_KEY=

# =============================================================================
# File Paths for Data Sources
# =============================================================================
# Host paths for `make dev`. In Docker the files are mounted from ./data and these
# are overridden (CONTAINER_RAILLINES_PATH / CONTAINER_ANNUAL_CLIMATE_PATH in compose.yml).
RAILLINES_PATH=
ANNUAL_CLIMATE_PATH=

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO
# json for production, text or color for development
LOG_FORMAT=color
LOG_REQUESTS=true
LOG_RESPONSES=true

# =============================================================================
# In-process cache (saves repeat external API calls; cleared on restart)
# =============================================================================
CACHE_ENABLED=true
