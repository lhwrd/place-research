# =============================================================================
# Database
# =============================================================================
# SQLite file holding properties, photos, locations and settings (created if missing)
DATABASE_PATH=db/place-research.db

# =============================================================================
# iOS Shortcut ingest token (openssl rand -hex 32)
# =============================================================================
INGEST_API_TOKEN=

# =============================================================================
# Zillow listing pages
# =============================================================================
# Enrichment fetches each listing's Zillow page for price, description, rental terms and
# photos. Zillow has no API and may answer with a captcha; set to false to stop trying.
ZILLOW_FETCH_ENABLED=true

# =============================================================================
# External API Keys
# =============================================================================
GOOGLE_MAPS_API_KEY=
# Street View on the property page is embedded with this key, which the browser sees.
# Use a separate key allowing the Maps Embed API and Street View Static API (the free
# panorama lookup that points the viewer at the house). Without it Street View is not shown;
# GOOGLE_MAPS_API_KEY is never sent to the browser.
GOOGLE_MAPS_EMBED_KEY=
WALKSCORE_API_KEY=
# Free: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# ACS 5-year release; each year's is out around December of the following year
CENSUS_ACS_YEAR=2024

# =============================================================================
# File Paths for Data Sources
# =============================================================================
# Host paths for `make dev`. In Docker the files are mounted from ./data and these
# are overridden (CONTAINER_*_PATH in compose.yml).
RAILLINES_PATH=
# Census TIGER major roads: uv run python scripts/build_highways.py data/highways.parquet
HIGHWAYS_PATH=
# FCC broadband by census block: see scripts/build_broadband.py for the download
BROADBAND_PATH=

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO
# json for production, text or color for development
LOG_FORMAT=color
LOG_REQUESTS=true
LOG_RESPONSES=true

# =============================================================================
# In-process cache (saves repeat external API calls; cleared on restart)
# =============================================================================
CACHE_ENABLED=true
