# Baserow (source of truth for properties)
BASEROW_URL=https://place-research-baserow.snake-snares.ts.net
BASEROW_API_TOKEN="op://Place Research - Test/baserow/api-token"
BASEROW_WEBHOOK_SECRET="op://Place Research - Test/baserow/webhook-secret"

# Point test at its own Baserow database: sharing prod's tables means both
# environments enrich the same rows. Leaving these empty disables ingest and webhooks.
BASEROW_DATABASE_ID=
BASEROW_PROPERTIES_TABLE_ID=
BASEROW_LOCATIONS_TABLE_ID=
BASEROW_SETTINGS_TABLE_ID=

# Ports
BACKEND_PORT=8000

# iOS Shortcut ingest token
INGEST_API_TOKEN="op://Place Research - Test/ingest/token"

# API Keys
GOOGLE_MAPS_API_KEY="op://Place Research - Test/google-maps/credential"
NATIONAL_FLOOD_DATA_API_KEY="op://Place Research - Test/national-flood-data/credential"
WALKSCORE_API_KEY="op://Place Research - Test/walkscore/credential"
AIRNOW_API_KEY="op://Place Research - Test/airnow/credential"

# Paths
RAILLINES_PATH=/app/data/raillines.geojson
ANNUAL_CLIMATE_PATH=/app/data/annual_average_climate.csv

# Application
LOG_LEVEL=DEBUG
LOG_FORMAT=text
APP_NAME="Place Research (Test)"

# GHCR
GHCR_USERNAME="op://Place Research - Prod/ghcr/username"
GHCR_TOKEN="op://Place Research - Prod/ghcr/credential"
