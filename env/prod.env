# Baserow (source of truth for properties)
BASEROW_URL=https://place-research-baserow.snake-snares.ts.net
BASEROW_API_TOKEN="op://Place Research - Prod/baserow/api-token"
BASEROW_WEBHOOK_SECRET="op://Place Research - Prod/baserow/webhook-secret"
# Locations/Settings ids are printed by apps/backend/scripts/baserow_setup.py
BASEROW_DATABASE_ID=259
BASEROW_PROPERTIES_TABLE_ID=837
BASEROW_LOCATIONS_TABLE_ID=
BASEROW_SETTINGS_TABLE_ID=

# iOS Shortcut ingest token
INGEST_API_TOKEN="op://Place Research - Prod/ingest/token"

# API Keys
GOOGLE_MAPS_API_KEY="op://Place Research - Prod/google-maps/credential"
NATIONAL_FLOOD_DATA_API_KEY="op://Place Research - Prod/national-flood-data/credential"
WALKSCORE_API_KEY="op://Place Research - Prod/walkscore/credential"
AIRNOW_API_KEY="op://Place Research - Prod/airnow/credential"

# Paths
RAILLINES_PATH=/app/data/raillines.geojson
ANNUAL_CLIMATE_PATH=/app/data/annual_average_climate.csv

# Application
LOG_LEVEL=WARNING
APP_NAME="Place Research"

# GHCR
GHCR_USERNAME="op://Place Research - Prod/ghcr/username"
GHCR_TOKEN="op://Place Research - Prod/ghcr/credential"
